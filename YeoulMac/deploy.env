# DeployBar 배포 설정 — 여울 맥 앱 (Mac App Store).
# iOS 앱(레포 최상단의 deploy.env)과 같은 앱 · 같은 번들 ID(com.leeo.yeoul) · 같은 인앱 상품을 쓴다.
# 이 폴더에 .xcodeproj 와 deploy.env 가 같이 있어서 DeployBar 가 별개 카드로 잡는다.

SCHEME=YeoulMac
PLATFORM=macos

# 폴더 밖에 있는 이 앱의 소스 — 공용 화면 · 요금제 · 번역 · 권한 파일
GIT_PATHS=../Shared,../Gyeol,../Config

# 다국어: iOS 앱과 같은 24개 언어
LOCALES=ko,en,en-GB,zh-Hans,zh-Hant,ja,ru,es,de,fr,it,pt-BR,th,vi,cs,da,el,fi,id,nb,nl,pl,sv,tr
LOCALIZATION_GATE=off
RELEASE_NOTES_GATE=strict
