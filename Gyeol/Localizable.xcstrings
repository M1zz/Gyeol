    "같은 태그가 붙은 사건을 모든 타임라인에서 모아 하나의 타임라인으로 보여 줘요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojí události se stejným štítkem ze všech časových os do jedné časové osy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samler alle begivenheder med samme tag fra alle tidslinjer i én tidslinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt alle Ereignisse mit demselben Hashtag aus allen Zeitleisten gesammelt in einer Zeitleiste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκεντρώνει τα γεγονότα με την ίδια ετικέτα από όλα τα χρονολόγια σε ένα χρονολόγιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See every event with the same tag from all timelines, gathered into one timeline."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See every event with the same tag from all timelines, gathered into one timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúne en una sola línea de tiempo los eventos con la misma etiqueta de todas tus líneas de tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerää saman tunnisteen tapahtumat kaikilta aikajanoilta yhdelle aikajanalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réunit en une seule frise tous les événements portant le même tag, toutes frises confondues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riunisce in un’unica timeline tutti gli eventi con lo stesso tag, da tutte le timeline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じタグが付いたイベントを、すべてのタイムラインから集めて1つのタイムラインで見せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 태그가 붙은 사건을 모든 타임라인에서 모아 하나의 타임라인으로 보여 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra, reunidos em uma só linha do tempo, todos os eventos com a mesma tag de todas as linhas do tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События с одним тегом из всех таймлайнов собираются в один таймлайн."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมเหตุการณ์ที่มีแท็กเดียวกันจากทุกไทม์ไลน์ให้เป็นไทม์ไลน์เดียว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gom các sự kiện có cùng thẻ từ mọi dòng thời gian thành một dòng thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把所有时间线中带有相同标签的事件汇集成一条时间线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把所有時間軸中帶有相同標籤的事件匯集成一條時間軸。"
          }
        }
      }
    },
