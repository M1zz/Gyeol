    "고른 타임라인에 사건을 남겨요. 날짜를 정하지 않으면 지금 시각으로 기록해요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá událost na vybranou časovou osu. Pokud nezadáte datum, zaznamená se s aktuálním časem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer en begivenhed til den tidslinje, du vælger. Hvis du ikke angiver en dato, registreres den med det aktuelle tidspunkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt der gewählten Zeitleiste ein Ereignis hinzu. Ohne Datumsangabe wird die aktuelle Uhrzeit verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει ένα γεγονός στο χρονολόγιο που επιλέγεις. Αν δεν ορίσεις ημερομηνία, καταγράφεται με την τρέχουσα ώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an event to the timeline you pick. If you don’t set a date, it’s logged at the current time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an event to the timeline you pick. If you don’t set a date, it’s logged at the current time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un evento a la línea de tiempo que elijas. Si no indicas una fecha, se registra con la hora actual."
          }
        },
        "fi" : {
