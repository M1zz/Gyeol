    "‘사건 추가’를 눌러 첫 순간을 남겨보세요.\n위에서 아래로 시간 순으로 쌓이고, 사이 간격은 실제로 흐른 시간만큼 벌어져요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na „Přidat událost“ uložte svůj první okamžik.\nUdálosti se řadí shora dolů podle času a mezery mezi nimi odpovídají skutečně uplynulému času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på “Tilføj begivenhed” for at gemme dit første øjeblik.\nBegivenhederne stables oppefra og ned i tidsrækkefølge, og afstanden mellem dem svarer til den tid, der faktisk er gået."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Ereignis hinzufügen“, um deinen ersten Moment festzuhalten.\nDie Ereignisse reihen sich von oben nach unten zeitlich auf, und die Abstände entsprechen der wirklich vergangenen Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα «Προσθήκη γεγονότος» για να κρατήσεις την πρώτη σου στιγμή.\nΤα γεγονότα στοιβάζονται από πάνω προς τα κάτω με χρονολογική σειρά και οι αποστάσεις είναι όσες και ο χρόνος που πέρασε πραγματικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Add Event” to save your first moment.\nEvents stack from top to bottom in time order, with gaps as wide as the time that really passed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Add Event” to save your first moment.\nEvents stack from top to bottom in time order, with gaps as wide as the time that really passed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Añadir evento» para guardar tu primer momento.\nLos eventos se apilan de arriba abajo por orden de tiempo, con una separación igual al tiempo que pasó de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta ”Lisää tapahtuma” tallentaaksesi ensimmäisen hetkesi.\nTapahtumat pinoutuvat ylhäältä alas aikajärjestyksessä, ja välit ovat yhtä pitkät kuin todellisuudessa kulunut aika."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Ajouter un événement » pour garder votre premier moment.\nLes événements s’empilent de haut en bas dans l’ordre chronologique, avec des écarts proportionnels au temps réellement écoulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca «Aggiungi evento» per salvare il tuo primo momento.\nGli eventi si dispongono dall’alto verso il basso in ordine di tempo, con distanze pari al tempo realmente trascorso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イベントを追加」をタップして、最初の瞬間を残しましょう。\n上から下へ時間順に並び、間隔は実際に流れた時間の分だけあきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘사건 추가’를 눌러 첫 순간을 남겨보세요.\n위에서 아래로 시간 순으로 쌓이고, 사이 간격은 실제로 흐른 시간만큼 벌어져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Adicionar evento” para guardar seu primeiro momento.\nOs eventos se empilham de cima para baixo em ordem de tempo, com intervalos do tamanho do tempo que realmente passou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Добавить событие», чтобы сохранить первый момент.\nСобытия выстраиваются сверху вниз по времени, а промежутки соответствуют реально прошедшему времени."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ “เพิ่มเหตุการณ์” เพื่อบันทึกช่วงเวลาแรกของคุณ\nเหตุการณ์จะเรียงจากบนลงล่างตามลำดับเวลา และระยะห่างจะกว้างเท่ากับเวลาที่ผ่านไปจริง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm “Thêm sự kiện” để lưu lại khoảnh khắc đầu tiên.\nCác sự kiện xếp từ trên xuống dưới theo thứ tự thời gian, khoảng cách giữa chúng giãn ra đúng bằng thời gian thực đã trôi qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“添加事件”，留下第一个瞬间吧。\n事件会按时间从上到下排列，间隔与实际流逝的时间一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「新增事件」，留下第一個瞬間吧。\n事件會依時間由上而下排列，間隔與實際流逝的時間一致。"
          }
        }
      }
    },
