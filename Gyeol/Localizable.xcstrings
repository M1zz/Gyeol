        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse sovellus Face ID:llä tai Touch ID:llä, niin aikajanasi pysyy yksityisenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
