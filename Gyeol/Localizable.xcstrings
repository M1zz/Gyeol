        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントを追加・削除するときに、軽い振動でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
