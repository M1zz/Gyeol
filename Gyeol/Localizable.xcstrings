    },
    "사건에 태그를 달고 누르면, 모든 타임라인에서 같은 태그가 붙은 순간을 모아 새 타임라인으로 보여 줘요. 기록은 iCloud로 아이폰·아이패드·맥에 이어져요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte událostem štítky a klepnutím na štítek spojíte všechny okamžiky se stejným štítkem ze všech časových os do nové časové osy. Vaše záznamy se přes iCloud synchronizují mezi iPhonem, iPadem a Macem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv begivenheder tags, og tryk på et tag for at samle alle øjeblikke med det tag fra alle dine tidslinjer i en ny tidslinje. Dine data synkroniseres mellem iPhone, iPad og Mac via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versieh Ereignisse mit Hashtags und tippe darauf, um alle Momente mit diesem Hashtag aus allen Zeitleisten in einer neuen Zeitleiste zu sammeln. Deine Einträge werden per iCloud zwischen iPhone, iPad und Mac synchronisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε ετικέτες στα γεγονότα και πάτα μία για να μαζέψεις όλες τις στιγμές με την ίδια ετικέτα από όλα τα χρονολόγια σε ένα νέο χρονολόγιο. Τα δεδομένα σου συγχρονίζονται ανάμεσα σε iPhone, iPad και Mac μέσω iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add tags to events and tap one to gather every moment with that tag, from all your timelines, into a new timeline. Your records sync across iPhone, iPad and Mac with iCloud."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add tags to events and tap one to gather every moment with that tag, from all your timelines, into a new timeline. Your records sync across iPhone, iPad and Mac with iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade etiquetas a tus eventos y toca una para reunir en una nueva línea de tiempo todos los momentos con esa etiqueta, de todas tus líneas de tiempo. Tus registros se sincronizan entre iPhone, iPad y Mac con iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tapahtumille tunnisteita ja napauta tunnistetta kerätäksesi kaikki saman tunnisteen hetket kaikilta aikajanoilta uudelle aikajanalle. Tietosi synkronoituvat iPhonen, iPadin ja Macin välillä iCloudin kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des tags à vos événements et touchez-en un pour réunir, dans une nouvelle frise, tous les moments portant ce tag, toutes frises confondues. Vos données se synchronisent entre iPhone, iPad et Mac via iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi tag agli eventi e toccane uno per riunire in una nuova timeline tutti i momenti con quel tag, da tutte le tue timeline. I tuoi dati si sincronizzano tra iPhone, iPad e Mac con iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントにタグを付けてタップすると、すべてのタイムラインから同じタグのイベントが集まり、新しいタイムラインになります。記録はiCloudでiPhone・iPad・Macにつながります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사건에 태그를 달고 누르면, 모든 타임라인에서 같은 태그가 붙은 순간을 모아 새 타임라인으로 보여 줘요. 기록은 iCloud로 아이폰·아이패드·맥에 이어져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione tags aos eventos e toque em uma para reunir, em uma nova linha do tempo, todos os momentos com essa tag de todas as suas linhas do tempo. Seus registros são sincronizados entre iPhone, iPad e Mac pelo iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте событиям теги и нажмите на тег — все моменты с этим тегом из всех таймлайнов соберутся в новый таймлайн. Записи синхронизируются между iPhone, iPad и Mac через iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่แท็กให้เหตุการณ์ แล้วแตะแท็กเพื่อรวมช่วงเวลาที่มีแท็กเดียวกันจากทุกไทม์ไลน์เป็นไทม์ไลน์ใหม่ ข้อมูลของคุณซิงก์ระหว่าง iPhone, iPad และ Mac ผ่าน iCloud"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gắn thẻ cho sự kiện rồi chạm vào thẻ để gom mọi khoảnh khắc có cùng thẻ từ tất cả dòng thời gian thành một dòng thời gian mới. Dữ liệu của bạn được đồng bộ giữa iPhone, iPad và Mac qua iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给事件添加标签并点按它，就能把所有时间线里带有同一标签的时刻汇集成一条新的时间线。记录会通过 iCloud 在 iPhone、iPad 和 Mac 之间同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為事件加上標籤並點一下，就能把所有時間軸裡帶有同一標籤的時刻匯集成一條新的時間軸。紀錄會透過 iCloud 在 iPhone、iPad 和 Mac 之間同步。"
          }
        }
      }
    },
    "사건을 넣거나 지울 때 가볍게 떨려서 알려 줘요." : {
      "comment" : "Roadmap item detail: haptics",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemné zavibrování, když událost přidáte nebo smažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et let vibrationsfeedback, når du tilføjer eller sletter en begivenhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanftes Vibrieren, wenn du ein Ereignis hinzufügst oder löschst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ελαφριά δόνηση όταν προσθέτεις ή διαγράφεις ένα γεγονός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle tap when you add or delete an event."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle tap when you add or delete an event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vibración suave al añadir o eliminar un evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kevyt värinä, kun lisäät tai poistat tapahtuman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une légère vibration quand vous ajoutez ou supprimez un événement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una leggera vibrazione quando aggiungi o elimini un evento."
