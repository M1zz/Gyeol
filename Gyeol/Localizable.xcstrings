    "보내 주신 의견은 개발자가 모두 직접 읽어요. 불편했던 점이나 바라는 기능을 알려 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vývojář čte každou zprávu osobně. Napište, co vám vadilo nebo jakou funkci byste chtěli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udvikleren læser selv alle beskeder. Fortæl os, hvad der var besværligt, eller hvilken funktion du savner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler liest jede Nachricht persönlich. Sag uns, was dich stört oder welche Funktion du dir wünschst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο προγραμματιστής διαβάζει προσωπικά κάθε μήνυμα. Πες μας τι σε δυσκόλεψε ή ποια λειτουργία θα ήθελες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer reads every message personally. Tell us what bothered you or what you’d like to see."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer reads every message personally. Tell us what bothered you or what you’d like to see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desarrollador lee personalmente todos los mensajes. Cuéntanos qué te ha molestado o qué función te gustaría ver."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehittäjä lukee jokaisen viestin itse. Kerro, mikä oli hankalaa tai mitä ominaisuutta kaipaat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le développeur lit lui-même chaque message. Dites-nous ce qui vous a gêné ou la fonction que vous aimeriez avoir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengembang membaca sendiri setiap pesan. Beri tahu kami apa yang kurang nyaman atau fitur yang kamu inginkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sviluppatore legge di persona ogni messaggio. Raccontaci cosa ti ha dato fastidio o quale funzione vorresti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いただいたご意見は、開発者がすべて自分で読んでいます。使いづらかった点や、欲しい機能を教えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내 주신 의견은 개발자가 모두 직접 읽어요. 불편했던 점이나 바라는 기능을 알려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvikleren leser alle meldinger selv. Fortell oss hva som var tungvint, eller hvilken funksjon du savner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ontwikkelaar leest elk bericht zelf. Laat weten wat er hinderlijk was of welke functie je mist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórca osobiście czyta wszystkie wiadomości. Napisz, co sprawiało kłopot albo jakiej funkcji ci brakuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desenvolvedor lê pessoalmente todas as mensagens. Conte o que incomodou ou qual recurso você gostaria de ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разработчик лично читает каждое сообщение. Расскажите, что вам неудобно или какой функции не хватает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvecklaren läser alla meddelanden själv. Berätta vad som var krångligt eller vilken funktion du saknar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักพัฒนาอ่านทุกข้อความด้วยตัวเอง บอกเราได้เลยว่าอะไรที่ใช้แล้วไม่สะดวก หรืออยากให้มีฟีเจอร์อะไร"
