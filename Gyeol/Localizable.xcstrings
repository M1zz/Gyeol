    "화면 읽기 기능이 단추와 사건을 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "comment" : "Roadmap item detail: VoiceOver",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver přečte každé tlačítko i událost, ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser hver knap og begivenhed op i den rigtige rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest jede Taste und jedes Ereignis vor, in der richtigen Reihenfolge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VoiceOver διαβάζει κάθε κουμπί και κάθε γεγονός, με τη σωστή σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and event, in the right order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and event, in the right order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee todos los botones y eventos, en el orden correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lukee jokaisen painikkeen ja tapahtuman oikeassa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit chaque bouton et chaque événement, dans le bon ordre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver membacakan setiap tombol dan peristiwa dengan urutan yang benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge ogni pulsante e ogni evento, nell’ordine giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOverがボタンとイベントを漏れなく、正しい順番で読み上げます。"
          }
        },
        "ko" : {
