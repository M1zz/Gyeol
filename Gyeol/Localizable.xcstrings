          }
        }
      }
    },
    "사건을 적다가 앱이 꺼져도 쓰던 내용이 남아 있어요." : {
      "comment" : "Roadmap item detail: keep a half-written event",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co píšete, zůstane zachováno, i když se aplikace uprostřed zavře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, du var i gang med at skrive, bliver stående, selv hvis appen lukker midt i det hele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du gerade schreibst, bleibt erhalten, auch wenn die App zwischendurch geschlossen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι έγραφες μένει στη θέση του, ακόμη κι αν η εφαρμογή κλείσει στη μέση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you were writing stays put, even if the app closes mid-way."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you were writing stays put, even if the app closes mid-way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que estabas escribiendo se conserva aunque la app se cierre a mitad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeneräinen kirjoitus säilyy, vaikka sovellus sulkeutuisi kesken kaiken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous écriviez reste en place, même si l’app se ferme en cours de route."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulisanmu tetap tersimpan meski aplikasi tertutup di tengah jalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che stavi scrivendo resta al suo posto, anche se l’app si chiude a metà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントを書いている途中でアプリが閉じても、書いた内容が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사건을 적다가 앱이 꺼져도 쓰던 내용이 남아 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du holdt på å skrive, blir stående, selv om appen lukkes midt i det hele."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je aan het schrijven was, blijft staan, ook als de app halverwege sluit."
          }
        },
        "pl" : {
          "stringUnit" : {
