    "Face ID나 Touch ID로 앱을 잠가 내 타임라인을 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci pomocí Face ID nebo Touch ID, aby vaše časová osa zůstala soukromá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så din tidslinje forbliver privat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID, damit deine Zeitleiste privat bleibt."
