        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà phát triển tự tay đọc mọi tin nhắn. Hãy cho chúng tôi biết điều gì bất tiện hoặc bạn muốn có tính năng gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你发来的每条意见，开发者都会亲自阅读。请告诉我们哪里用着不顺手，或者你希望增加什么功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
