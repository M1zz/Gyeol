    "사진과 메모가 그 자리에서 열려요. 다시 누르면 접혀요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky a poznámky se otevřou na místě. Dalším klepnutím je sbalíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billeder og noter åbner sig på stedet. Tryk igen for at folde sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos und Notizen öffnen sich an Ort und Stelle. Tippe erneut, um sie zu schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες και οι σημειώσεις ανοίγουν επιτόπου. Πάτα ξανά για να κλείσουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos and notes open in place. Tap again to fold."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos and notes open in place. Tap again to fold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos y las notas se abren en el sitio. Vuelve a tocar para plegar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvat ja muistiinpanot avautuvat paikallaan. Napauta uudelleen sulkeaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et notes s’ouvrent sur place. Touchez à nouveau pour replier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto e note si aprono sul posto. Tocca di nuovo per richiuderle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真とメモがその場で開きます。もう一度タップすると閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
