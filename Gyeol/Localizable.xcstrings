          "stringUnit" : {
            "state" : "translated",
            "value" : "관련된 사진 찾기"
          }
        }
      }
    },
    "그 날 찍은 사진을 바로 붙여요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add photos from that day"
