        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임 줄이기를 켜면 화면 효과가 차분해져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
