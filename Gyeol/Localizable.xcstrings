    "움직임 줄이기를 켜면 화면 효과가 차분해져요." : {
      "comment" : "Roadmap item detail: reduce motion",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zapnete Omezit pohyb, efekty na obrazovce budou klidnější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Reducer bevægelse er slået til, bliver skærmeffekterne mere afdæmpede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei aktivierter Option „Bewegung reduzieren“ werden Bildschirmeffekte ruhiger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργή τη Μείωση κίνησης, τα εφέ της οθόνης γίνονται πιο ήρεμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Reducir movimiento activado, los efectos de pantalla son más tranquilos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Vähennä liikettä on päällä, näytön tehosteet rauhoittuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Réduire les animations activé, les effets d’écran se font plus discrets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Riduci movimento attivo, gli effetti sullo schermo diventano più calmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」をオンにすると、画面の動きが穏やかになります。"
