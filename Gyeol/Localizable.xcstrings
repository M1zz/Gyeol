        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 锁定 App，保护你的时间线隐私。"
          }
        }
      }
    },
    "VoiceOver로 더 편하게" : {
      "comment" : "Roadmap item: VoiceOver",
