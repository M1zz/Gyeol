    "처음 열었을 때 보았던 안내를 다시 볼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu si projděte úvod, který jste viděli při prvním spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se introduktionen igen, som du så, første gang du åbnede appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir die Einführung vom ersten Start noch einmal an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες ξανά την εισαγωγή που είδες όταν άνοιξες την εφαρμογή για πρώτη φορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the intro you saw when you first opened the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the intro you saw when you first opened the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ver la introducción que viste al abrir la app por primera vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso uudelleen esittely, jonka näit avatessasi sovelluksen ensimmäisen kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoyez l’introduction affichée à la première ouverture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat lagi pengenalan yang kamu lihat saat pertama kali membuka aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi l’introduzione che hai visto al primo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初めて開いたときに見た案内をもう一度確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 열었을 때 보았던 안내를 다시 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se introduksjonen du fikk første gang du åpnet appen, på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk de introductie van je eerste keer openen nog eens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejrzyj jeszcze raz wprowadzenie z pierwszego uruchomienia aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja a introdução que você viu ao abrir o app pela primeira vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё раз посмотрите вступление, которое вы видели при первом запуске."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se introduktionen du fick första gången du öppnade appen igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูคำแนะนำที่เห็นตอนเปิดแอปครั้งแรกอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı ilk açtığında gördüğün tanıtımı yeniden izle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại phần giới thiệu bạn đã thấy khi mở ứng dụng lần đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新查看第一次打开时看到的介绍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新查看第一次開啟時看到的介紹。"
          }
        }
      }
    },
    "첫 타임라인을 만들어보세요.\n아이의 첫 해, 앱 출시 기록, 여행 — 무엇이든 좋아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte svou první časovou osu.\nPrvní rok miminka, spuštění aplikace, cesta — cokoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret din første tidslinje.\nBarnets første år, en app-lancering, en rejse – alt er velkomment."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege deine erste Zeitleiste an.\nDas erste Jahr deines Kindes, ein App-Launch, eine Reise – alles ist möglich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιούργησε το πρώτο σου χρονολόγιο.\nΤο πρώτο έτος του μωρού, η κυκλοφορία μιας εφαρμογής, ένα ταξίδι — ό,τι θέλεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start your first timeline.\nA baby’s first year, an app launch, a trip — anything goes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start your first timeline.\nA baby’s first year, an app launch, a trip — anything goes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu primera línea de tiempo.\nEl primer año de tu bebé, el lanzamiento de una app, un viaje… lo que quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo ensimmäinen aikajanasi.\nVauvan ensimmäinen vuosi, sovelluksen julkaisu, matka – mikä vain käy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre première frise.\nLa première année de bébé, un lancement d’app, un voyage… tout est permis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat linimasa pertamamu.\nTahun pertama si kecil, peluncuran aplikasi, perjalanan — apa saja boleh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la tua prima timeline.\nIl primo anno del bambino, il lancio di un’app, un viaggio: va bene tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のタイムラインを作ってみましょう。\nお子さまの1年目、アプリ公開までの記録、旅行など、何でもOKです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 타임라인을 만들어보세요.\n아이의 첫 해, 앱 출시 기록, 여행 — 무엇이든 좋아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag din første tidslinje.\nBarnets første år, en applansering, en reise – alt går an."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je eerste tijdlijn.\nHet eerste jaar van je kindje, een app-lancering, een reis – het mag alles zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz swoją pierwszą oś czasu.\nPierwszy rok dziecka, premiera aplikacji, podróż – wszystko się nadaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie sua primeira linha do tempo.\nO primeiro ano do bebê, o lançamento de um app, uma viagem… qualquer coisa serve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте первый таймлайн.\nПервый год малыша, запуск приложения, путешествие — что угодно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa din första tidslinje.\nBabyns första år, en applansering, en resa – vad som helst går bra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองสร้างไทม์ไลน์แรกของคุณ\nขวบปีแรกของลูก การเปิดตัวแอป ทริปท่องเที่ยว — อะไรก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk zaman çizelgeni oluştur.\nBebeğin ilk yılı, bir uygulama lansmanı, bir yolculuk — her şey olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tạo dòng thời gian đầu tiên của bạn.\nNăm đầu đời của con, ngày ra mắt ứng dụng, một chuyến đi — gì cũng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建你的第一条时间线吧。\n宝宝的第一年、App 上线记录、一次旅行——什么都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立你的第一條時間軸吧。\n寶寶的第一年、App 上架紀錄、一趟旅行——什麼都可以。"
          }
        }
      }
    },
