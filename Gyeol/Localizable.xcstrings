          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rung nhẹ khi bạn thêm hoặc xóa một sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
