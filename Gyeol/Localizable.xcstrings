          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если приложение закроется, пока вы пишете событие, написанное сохранится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
