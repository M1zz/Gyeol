    "사진 접근이 꺼져 있어 이 날 찍은 사진을 찾을 수 없어요.\n아래에서 직접 고를 수는 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k Fotkám je vypnutý, proto nelze najít fotky z toho dne.\nStále si ale můžete vybrat níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til Billeder er slået fra, så billederne fra den dag kan ikke findes.\nDu kan stadig vælge selv herunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf Fotos ist deaktiviert, daher können die Fotos von diesem Tag nicht gefunden werden.\nUnten kannst du trotzdem selbst eines auswählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στις Φωτογραφίες είναι απενεργοποιημένη και δεν βρίσκονται φωτογραφίες εκείνης της μέρας.\nΜπορείς πάντως να διαλέξεις μία παρακάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is off, so photos from that day can’t be found.\nYou can still pick one below."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is off, so photos from that day can’t be found.\nYou can still pick one below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a Fotos está desactivado, así que no se pueden buscar las fotos de ese día.\nAun así, puedes elegir una abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pääsy Kuviin on pois päältä, joten sinä päivänä otettuja kuvia ei löydy.\nVoit silti valita kuvan itse alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux photos est désactivé : impossible de trouver les photos prises ce jour-là.\nVous pouvez tout de même en choisir une ci-dessous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses Foto dimatikan, jadi foto yang diambil hari itu tidak bisa ditemukan.\nKamu tetap bisa memilih sendiri di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alle foto è disattivato, quindi non è possibile trovare le foto scattate quel giorno.\nPuoi comunque sceglierne una qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスがオフのため、この日に撮った写真を探せません。\n下から自分で選ぶことはできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 접근이 꺼져 있어 이 날 찍은 사진을 찾을 수 없어요.\n아래에서 직접 고를 수는 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til Bilder er slått av, så bildene fra den dagen kan ikke finnes.\nDu kan likevel velge selv nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot Foto’s staat uit, dus de foto’s van die dag kunnen niet worden gevonden.\nJe kunt hieronder nog wel zelf een foto kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do Zdjęć jest wyłączony, więc nie można znaleźć zdjęć z tego dnia.\nNadal możesz wybrać zdjęcie samodzielnie poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às Fotos está desativado, então não dá para encontrar as fotos daquele dia.\nVocê ainda pode escolher uma abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к фото отключён, поэтому найти снимки того дня не получится.\nВыбрать фото вручную можно ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till Bilder är avstängd, så bilderna från den dagen kan inte hittas.\nDu kan ändå välja själv nedan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงรูปภาพปิดอยู่ จึงค้นหารูปที่ถ่ายในวันนั้นไม่ได้\nแต่ยังเลือกเองจากด้านล่างได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflara erişim kapalı olduğundan o gün çekilen fotoğraflar bulunamıyor.\nYine de aşağıdan kendin seçebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập Ảnh đang tắt nên không tìm được ảnh chụp hôm đó.\nBạn vẫn có thể tự chọn ở bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片访问权限已关闭，无法查找当天拍摄的照片。\n你仍然可以在下方手动选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片取用權限已關閉，無法尋找當天拍攝的照片。\n你仍可在下方手動選取。"
          }
        }
      }
    },
