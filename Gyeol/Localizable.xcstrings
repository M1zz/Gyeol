        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci aplikasi dengan Face ID atau Touch ID agar linimasamu tetap pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
