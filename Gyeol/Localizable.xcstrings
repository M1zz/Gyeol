    "움직임 줄이기를 켜면 화면 효과가 차분해져요." : {
      "comment" : "Roadmap item detail: reduce motion",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zapnete Omezit pohyb, efekty na obrazovce budou klidnější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Reducer bevægelse er slået til, bliver skærmeffekterne mere afdæmpede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei aktivierter Option „Bewegung reduzieren“ werden Bildschirmeffekte ruhiger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργή τη Μείωση κίνησης, τα εφέ της οθόνης γίνονται πιο ήρεμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Reducir movimiento activado, los efectos de pantalla son más tranquilos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Vähennä liikettä on päällä, näytön tehosteet rauhoittuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Réduire les animations activé, les effets d’écran se font plus discrets."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Kurangi Gerakan aktif, efek layar jadi lebih tenang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Riduci movimento attivo, gli effetti sullo schermo diventano più calmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」をオンにすると、画面の動きが穏やかになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임 줄이기를 켜면 화면 효과가 차분해져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Reduser bevegelse er på, blir skjermeffektene roligere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Beperk beweging aan worden schermeffecten rustiger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączona jest opcja Redukuj ruch, efekty na ekranie stają się spokojniejsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Reduzir Movimento ativado, os efeitos na tela ficam mais calmos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включить «Уменьшение движения», эффекты на экране станут спокойнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Minska rörelse på blir skärmeffekterna lugnare."
          }
