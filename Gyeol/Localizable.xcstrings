    "Face ID 잠금" : {
      "comment" : "Roadmap item: Face ID lock",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID lock"
          }
        },
        "en-GB" : {
