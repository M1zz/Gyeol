    "Face ID나 Touch ID로 앱을 잠가 내 타임라인을 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID, damit deine Zeitleiste privat bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your timeline private."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your timeline private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para que tu línea de tiempo siga siendo privada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDやTouch IDでアプリをロックして、タイムラインを守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
