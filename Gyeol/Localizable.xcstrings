        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần bạn đang viết vẫn được giữ lại, kể cả khi ứng dụng bị đóng giữa chừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写事件时即使 App 意外关闭，已写的内容也会保留。"
          }
        },
        "zh-Hant" : {
