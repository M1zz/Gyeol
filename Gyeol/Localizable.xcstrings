    "처음 열었을 때 보았던 안내를 다시 볼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu si projděte úvod, který jste viděli při prvním spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se introduktionen igen, som du så, første gang du åbnede appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir die Einführung vom ersten Start noch einmal an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες ξανά την εισαγωγή που είδες όταν άνοιξες την εφαρμογή για πρώτη φορά."
          }
        },
        "en" : {
          "stringUnit" : {
