    "대비를 높이거나 색을 구별하기 어려워도 태그와 사건을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snadno rozlišíte štítky a události, i když máte zapnuté Zvýšit kontrast nebo se vám špatně rozlišují barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nemt forskel på tags og begivenheder, også med Øg kontrast slået til, eller hvis farver er svære at skelne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne Hashtags und Ereignisse leicht, auch mit erhöhtem Kontrast oder bei Schwierigkeiten, Farben zu unterscheiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεχώρισε εύκολα ετικέτες και γεγονότα, ακόμη και με ενεργό το Αύξηση αντίθεσης ή αν δυσκολεύεσαι να ξεχωρίσεις χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell tags and events apart easily, even with Increase Contrast on or if colors are hard to distinguish."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell tags and events apart easily, even with Increase Contrast on or if colours are hard to distinguish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue fácilmente etiquetas y eventos, incluso con Aumentar contraste o si te cuesta diferenciar colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erota tunnisteet ja tapahtumat helposti, vaikka Lisää kontrastia olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinguez facilement tags et événements, même avec Contraste renforcé ou si les couleurs sont difficiles à distinguer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedakan tag dan peristiwa dengan mudah, bahkan saat Tingkatkan Kontras aktif atau warna sulit dibedakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingui facilmente tag ed eventi, anche con Aumenta contrasto attivo o se fai fatica a distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別がつきにくくても、タグとイベントを見分けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 태그와 사건을 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se enkelt forskjell på merker og hendelser, også med Øk kontrast slått på eller hvis det er vanskelig å skille farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderscheid tags en gebeurtenissen makkelijk, ook met Verhoog contrast aan of als kleuren lastig te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łatwo odróżnisz tagi i wydarzenia, także przy włączonym Zwiększ kontrast albo gdy trudno ci rozróżniać kolory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferencie tags e eventos com facilidade, mesmo com Aumentar Contraste ativado ou se for difícil distinguir cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теги и события легко различать, даже если включена повышенная контрастность или трудно отличать цвета."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lätt skillnad på taggar och händelser, även med Öka kontrast på eller om det är svårt att skilja på färger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แยกแท็กและเหตุการณ์ได้ง่าย แม้เปิดเพิ่มความคมชัดหรือแยกสีได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı artırsan ya da renkleri ayırt etmekte zorlansan bile etiketleri ve olayları kolayca ayırt et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dễ phân biệt thẻ và sự kiện, kể cả khi bật Tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”或不易分辨颜色时，也能轻松认出标签和事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」或不易分辨顏色時，也能輕鬆認出標籤和事件。"
          }
        }
      }
    },
