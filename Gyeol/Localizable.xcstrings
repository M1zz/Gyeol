        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείδωσε την εφαρμογή με Face ID ή Touch ID για να μένει το χρονολόγιό σου ιδιωτικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your timeline private."
          }
        },
