        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγεθύνεις το κείμενο, οι οθόνες αναδιατάσσονται σωστά αντί να κόβονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aumentar el tamaño del texto, las pantallas se reorganizan bien en lugar de cortarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, näkymät järjestyvät siististi uudelleen sen sijaan, että ne leikkautuisivat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, les écrans se réorganisent proprement au lieu d’être coupés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat teks diperbesar, layar tertata ulang dengan rapi dan tidak terpotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ingrandisci il testo, le schermate si riorganizzano bene invece di essere tagliate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れずに、見やすく並べ直されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du forstørrer teksten, ordnes skjermbildene pent i stedet for å bli kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de tekst vergroot, worden schermen netjes opnieuw ingedeeld in plaats van afgesneden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po powiększeniu tekstu ekrany układają się czytelnie zamiast się ucinać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o tamanho do texto, as telas se reorganizam direitinho em vez de serem cortadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличенном шрифте экраны аккуратно перестраиваются, а текст не обрезается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du förstorar texten ordnas skärmarna om snyggt i stället för att klippas av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายขนาดตัวอักษร หน้าจอจะจัดเรียงใหม่อย่างสวยงามโดยไม่ถูกตัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazıyı büyüttüğünde ekranlar kesilmek yerine düzgünce yeniden yerleşir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn phóng to chữ, màn hình tự sắp xếp lại gọn gàng thay vì bị cắt mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
