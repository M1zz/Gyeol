    "NSPhotoLibraryUsageDescription" : {
      "comment" : "사진 접근 권한 안내",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul potřebuje přístup k fotkám, aby našel snímky pořízené toho dne a připojil je k události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul skal have adgang til dine billeder for at finde dem, du tog den dag, og føje dem til begivenheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul braucht Zugriff auf deine Fotos, um die Bilder von diesem Tag zu finden und dem Ereignis hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Yeoul χρειάζεται πρόσβαση στις φωτογραφίες σου για να βρει όσες τράβηξες εκείνη τη μέρα και να τις επισυνάψει στο γεγονός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul needs access to your photos to find the ones you took on that day and attach them to an event."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul needs access to your photos to find the ones you took on that day and attach them to an event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul necesita acceder a tus fotos para encontrar las que hiciste ese día y añadirlas al evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul tarvitsee pääsyn kuviisi löytääkseen sinä päivänä otetut kuvat ja liittääkseen ne tapahtumaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul a besoin d’accéder à vos photos pour retrouver celles prises ce jour-là et les joindre à l’événement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul memerlukan akses ke foto untuk menemukan foto yang kamu ambil pada hari itu dan melampirkannya ke peristiwa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul ha bisogno di accedere alle foto per trovare quelle scattate quel giorno e allegarle all’evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その日に撮った写真を探してイベントに添付するため、写真へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 날 찍은 사진을 찾아 사건에 붙이기 위해 사진 접근이 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul trenger tilgang til bildene dine for å finne dem du tok den dagen og legge dem til hendelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul heeft toegang tot je foto’s nodig om de foto’s van die dag te vinden en aan de gebeurtenis toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul potrzebuje dostępu do zdjęć, aby znaleźć te zrobione tego dnia i dołączyć je do wydarzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Yeoul precisa acessar suas fotos para encontrar as que você tirou naquele dia e anexá-las ao evento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul нужен доступ к фото, чтобы найти снимки, сделанные в тот день, и прикрепить их к событию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul behöver åtkomst till dina bilder för att hitta dem du tog den dagen och lägga till dem i händelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul ต้องเข้าถึงรูปภาพเพื่อค้นหารูปที่ถ่ายในวันนั้นและแนบไว้กับเหตุการณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul’un o gün çektiğin fotoğrafları bulup olaya ekleyebilmesi için fotoğraflarına erişmesi gerekiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul cần quyền truy cập ảnh để tìm những ảnh bạn chụp vào ngày đó và gắn vào sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul 需要访问你的照片，以找到当天拍摄的照片并添加到事件中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeoul 需要取用你的照片，才能找到當天拍的照片並加到事件中。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
